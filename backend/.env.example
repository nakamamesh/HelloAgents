# Server-side secrets only — never expose to browser/client
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

DATABASE_URL=postgresql+asyncpg://helloagents:helloagents@localhost:5432/helloagents
REDIS_URL=redis://localhost:6379/0

APP_ENV=local
APP_NAME=HelloAgents
API_HOST=0.0.0.0
API_PORT=8000

# Control plane + machine auth (server-side only)
ADMIN_API_KEY=dev-admin-change-me
JWT_SECRET=dev-jwt-change-me-to-at-least-32-chars
JWT_EXPIRES_MINUTES=60
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Phase 3 — Coinbase CDP agentic wallets (Base Sepolia)
# Create at https://portal.cdp.coinbase.com — API key + Wallet Secret
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
CDP_NETWORK=base-sepolia
# Optional: policy id from CDP Portal (per-tx caps + allowlist)
CDP_ACCOUNT_POLICY_ID=
# Set true in prod once CDP keys are live
CDP_REQUIRED=false

# Server-side secrets only — never expose to browser/client
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

DATABASE_URL=postgresql+asyncpg://helloagents:helloagents@localhost:5432/helloagents
REDIS_URL=redis://localhost:6379/0

APP_ENV=local
APP_NAME=HelloAgents
API_HOST=0.0.0.0
API_PORT=8000

# Control plane + machine auth (server-side only)
ADMIN_API_KEY=dev-admin-change-me
JWT_SECRET=dev-jwt-change-me-to-at-least-32-chars
JWT_EXPIRES_MINUTES=60
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Phase 3 — Turnkey agent wallets (https://docs.turnkey.com)
# Create org + API user at https://app.turnkey.com
TURNKEY_ORGANIZATION_ID=
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=
TURNKEY_API_BASE_URL=https://api.turnkey.com
WALLET_NETWORK=base-sepolia
WALLET_REQUIRED=false
